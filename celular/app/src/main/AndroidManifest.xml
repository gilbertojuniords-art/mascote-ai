<?xml version="1.0" encoding="utf-8"?>
<!-- Só uma permissão: usar a digital (o Android exige; sem ela o app fechava ao pedir a digital).
     Sem internet e sem acesso a nada do celular. Só assina. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/icone"
        android:label="Sexta Digital"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Compartilhar" um texto do Telegram com o app também abre o pedido -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
